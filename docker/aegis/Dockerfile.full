# docker/aegis/Dockerfile.full — AEGIS com Ollama integrado
# Para utilizadores que precisam de `sca plugin add` / `sca build`.
#
# Build: docker build -t aegis/aegis:full -f docker/aegis/Dockerfile.full .
# Uso:   sca plugin add --source benchmark.pdf
#
# Nota: parte da imagem runtime (aegis:latest). O Ollama é instalado como root
# (escreve em /usr/local/bin e em /root/.ollama); o entrypoint arranca o serviço
# Ollama em background antes de invocar o sca.

FROM aegis:latest

# A imagem base termina como utilizador não-root (aegis); o Ollama precisa de root.
USER root

# Dependências do instalador do Ollama (extração com zstd) e instalação do Ollama.
RUN apt-get update \
    && apt-get install -y --no-install-recommends zstd ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://ollama.com/install.sh | sh

# Entrypoint inteligente (arranca Ollama, garante o modelo, executa sca)
COPY docker/aegis/entrypoint_full.sh /entrypoint_full.sh
RUN chmod +x /entrypoint_full.sh

ENTRYPOINT ["/entrypoint_full.sh"]
CMD []
