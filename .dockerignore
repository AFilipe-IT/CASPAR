# .dockerignore — keeps the build context small.
# NOTE: data/ccss_canonical.sql MUST be included (the image restores the DB
# from it), so we are careful NOT to exclude it.

.venv/
venv/
env/
.git/
.github/

__pycache__/
*.pyc
*.pyo
*.pyd

# Built SQLite databases — the image restores from data/ccss_canonical.sql.
*.db
*.db-shm
*.db-wal
*.db.bak

# Local snapshots / scratch SQL (but NOT the canonical dump in data/).
ccss_before_*.sql
ccss_fresh.sql
ccss_reference.sql

# Test fixtures and generated artefacts.
benchmarks/
reports/*
!reports/.gitkeep
.pytest_cache/
.coverage
htmlcov/

# Generated documents.
**/*.docx
*.docx

# Benchmark PDFs are build-time only (LLM/RAG extraction). The scan runtime
# never reads them, so they are excluded from the image to keep it small.
# (Saves ~85MB — the SSH CIS benchmark alone is 78MB.)
**/*.pdf
*.pdf
# Exception: the CCSS spec (NISTIR 7502, ~285KB) is the SHARED RAG knowledge
# for every target's Layer 3 (--assess-unknown). _find_knowledge_docs expects
# it at the app root — bake it in so it works on any machine, offline.
!nistir7502.pdf

# Frontend (CVM console). The console is built in its own stage in
# docker/caspar/Dockerfile, which COPYs frontend/ explicitly *before* this
# ignore applies to the final stage's `COPY . .`. Only node_modules and local
# build output are excluded — 128MB of dependencies that the runtime image
# never needs, and a dist/ that must come from the build stage (reproducible)
# rather than from whatever the developer happened to have built locally.
frontend/node_modules/
frontend/dist/

# Editor / OS.
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# The docker dir itself (Dockerfiles are passed via -f; no need in context).
docker/
# Exception: caspar:full needs the entrypoint script in the build context.
!docker/caspar/entrypoint_full.sh
# Exception: the :latest image COPYs the data-seeding script.
!docker/caspar/seed_data.sh
