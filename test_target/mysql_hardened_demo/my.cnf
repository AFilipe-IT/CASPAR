# test_target/mysql_demo/my_hardened.cnf
# Fixture CORRETAMENTE configurada para o target 'mysql' — as diretivas
# cobertas pela suite de recall (mysql_demo/my.cnf) em valores seguros.
# Qualquer finding aqui é um falso positivo (precisão/F1).

[mysqld]
ssl_cipher = TLS_AES_256_GCM_SHA384
block_encryption_mode = aes-256-cbc
bind_address = 127.0.0.1
allow-suspicious-udfs = OFF
local_infile = OFF
skip-grant-tables = FALSE
skip-symbolic-links = YES
sql_mode = STRICT_ALL_TABLES,NO_ENGINE_SUBSTITUTION
log-bin = /var/log/mysql/bin-log
log-warnings = 2
log-raw = OFF
audit_log_connection_policy = ALL
old_passwords = 0
secure_auth = ON
have_ssl = YES
master_info_repository = TABLE
